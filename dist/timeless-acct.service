# timeless-acct as a system service, keeping a store of its own in
# /var/lib/timeless-acct. dist/install.sh puts it in place:
#
#   cargo build --release
#   sudo dist/install.sh
#
# It runs as an unprivileged user that holds exactly three capabilities, and
# `timeless-acct check` says what each one buys:
#
#   CAP_NET_ADMIN          exit records from the kernel, and word of each exec
#   CAP_SYS_PTRACE         the I/O, open files, and executable of processes
#   CAP_DAC_READ_SEARCH    that belong to other users; it takes both
#
# Exit accounting is only offered to the initial user and PID namespaces, so
# the unit must not set PrivateUsers= or run inside a container.

[Unit]
Description=timeless-acct: system and process accounting history
Documentation=https://github.com/awksedgreep/timeless-acct
After=network-online.target
Wants=network-online.target

[Service]
# The host's store, which `timeless-acct watch` reads when its user has
# none of their own.
ExecStart=/usr/local/bin/timeless-acct run --data-dir /var/lib/timeless-acct

# Or to the Timeless planes, which is what the canvas reads:
#ExecStart=/usr/local/bin/timeless-acct run --sink http
#Environment=TIMELESS_ACCT_METRICS_URL=http://127.0.0.1:8428
#Environment=TIMELESS_ACCT_LOGS_URL=http://127.0.0.1:9428
#Environment=TIMELESS_ACCT_TRACES_URL=http://127.0.0.1:10428
# A bearer token, for planes that require one: TIMELESS_ACCT_TOKEN=...
#EnvironmentFile=-/etc/timeless-acct.env

# A user of its own, from dist/timeless-acct.sysusers. Its group's members
# may read the store: it holds what every process on the host was run
# with, so the group is for those who may see that.
User=timeless-acct
Group=timeless-acct
StateDirectory=timeless-acct
StateDirectoryMode=0750
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes

# It reads the whole system and writes only its own state.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Time to flush and checkpoint.
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
